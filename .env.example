DATABASE_URL=""
WEBHOOK_SECRET=""
AUTH_SECRET=""
NEXT_PUBLIC_APP_NAME="木远 CRM"
DEFAULT_TIMEZONE="Asia/Shanghai"
DEFAULT_CURRENCY="CNY"
SEED_ADMIN_PASSWORD=""

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# Meta WhatsApp Cloud API + Business App Coexistence
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_GRAPH_VERSION="v26.0"
WHATSAPP_VERIFY_TOKEN=""
# Facebook Lead Ads（独立于 WhatsApp 那条线）
# 专用于 Meta Webhook 验证的 hub.verify_token，不要复用 WEBHOOK_SECRET
META_LEAD_WEBHOOK_SECRET=""
# 兼容旧名（若已配置 META_LEAD_VERIFY_TOKEN 仍可生效）
META_LEAD_VERIFY_TOKEN=""
# 用于调用 Graph API 读取 leadgen 详情（Page Access Token）
META_PAGE_ACCESS_TOKEN=""

# Meta 广告数据 + 表单目录同步（Marketing API，与 Lead Ads 推送互补）
# 广告账户 ID：act_ 开头（Business 设置 → 广告账户）；裸数字亦可
META_AD_ACCOUNT_ID=""
# System User Token：Business 设置 → System users → 生成 Token，权限勾选 ads_read
META_ADS_ACCESS_TOKEN=""
# 主页 ID：用于拉取 leadgen_forms 表单目录（可选，缺省则不同步表单）
META_PAGE_ID=""
# 定时同步入口 /api/cron/meta-sync?secret=<此值> 的密钥（Hostinger Cron 用）
META_SYNC_SECRET=""
WHATSAPP_DEFAULT_OWNER_EMAIL="admin@example.com"
# Optional but recommended when the WABA has multiple phone numbers.
WHATSAPP_PREFERRED_PHONE_NUMBER_ID=""

# WhatsApp CRM V2 (Gupshup Self-Serve)
GUPSHUP_API_KEY=""
# Registered business number, international digits without +
GUPSHUP_SOURCE=""
GUPSHUP_APP_NAME=""
# Set callback to /api/whatsapp/webhook?token=<this-secret> when enabled.
GUPSHUP_WEBHOOK_SECRET=""

# Sales Workspace V3 media attachments
# Public HTTPS origin; required behind proxies that expose an internal request origin.
PUBLIC_APP_URL=""
# Persistent writable directory outside deployment releases. Default: uploads/whatsapp
MEDIA_STORAGE_DIR=""

# WhatsApp Web 本地同步助手：无需新增服务端环境变量。
# 继续使用上面的 DATABASE_URL 与 AUTH_SECRET；扩展授权从 CRM 页面创建。

# 身份链后台处理：POST /api/cron/identity-chain，x-cron-secret 使用 META_SYNC_SECRET。
# body.kind: leads / analysis / daily / feedback / all；建议按任务分开调度。
# 广告转换回传默认关闭；仅在确认 Dataset 权限及事件配置后启用。
META_FEEDBACK_ENABLED="false"
META_DATASET_ID=""
META_CAPI_ACCESS_TOKEN=""
