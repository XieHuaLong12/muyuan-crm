{
 "name": "furniture-crm",
 "version": "1.0.0",
 "private": true,
 "scripts": {
  "dev": "next dev --hostname 127.0.0.1",
  "build": "prisma generate && node scripts/production-init.mjs && next build",
  "start": "node scripts/production-init.mjs && next start",
  "lint": "eslint .",
  "db:migrate": "prisma migrate dev",
  "db:seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/seed.ts",
  "test": "node --env-file=.env --import ./scripts/test-database-guard.mjs node_modules/tsx/dist/cli.mjs --test --test-concurrency=1 tests/*.test.ts",
  "db:init": "node scripts/init-db.mjs",
  "test:smoke": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/smoke.ts",
  "db:seed:products": "node node_modules/tsx/dist/cli.mjs prisma/seed-product-os.ts",
  "db:seed:orders": "node node_modules/tsx/dist/cli.mjs prisma/seed-orders.ts",
  "meta:doctor": "node scripts/meta-lead-doctor.mjs",
  "meta:sync": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/meta-sync.ts"
 },
 "dependencies": {
  "@hookform/resolvers": "^3.10.0",
  "@prisma/client": "6.19.0",
  "@radix-ui/react-dialog": "^1.1.0",
  "clsx": "^2.1.1",
  "date-fns": "^4.1.0",
  "date-fns-tz": "^3.2.0",
  "html-to-image": "1.11.13",
  "libphonenumber-js": "^1.13.14",
  "lucide-react": "^0.468.0",
  "next": "^15.5.0",
  "react": "^19.1.0",
  "react-dom": "^19.1.0",
  "react-hook-form": "^7.62.0",
  "recharts": "^3.1.0",
  "tailwind-merge": "^3.3.0",
  "web-push": "3.6.7",
  "zod": "^3.25.0"
 },
 "devDependencies": {
  "@eslint/eslintrc": "^3.3.7",
  "@tailwindcss/postcss": "^4.1.0",
  "@types/node": "^22.0.0",
  "@types/react": "^19.1.0",
  "@types/react-dom": "^19.1.0",
  "@types/web-push": "3.6.4",
  "eslint": "^9.0.0",
  "eslint-config-next": "^15.5.0",
  "prisma": "6.19.0",
  "tailwindcss": "^4.1.0",
  "tsx": "^4.20.0",
  "typescript": "^5.9.0"
 },
 "engines": {
  "node": ">=22"
 },
 "packageManager": "pnpm@11.27.0"
}
