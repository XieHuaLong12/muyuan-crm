generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "mysql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 role String @default("SALES")
 createdAt DateTime @default(now())
 customers Customer[]
}
model Customer {
 id String @id @default(cuid())
 name String
 companyName String @default("")
 country String @default("")
 countryCode String @default("")
 city String @default("")
 phone String @default("")
 whatsapp String @default("")
 whatsappNormalized String @default("")
 waId String?
 email String @default("")
 source String @default("OTHER")
 sourceDetail String @default("")
 language String @default("")
 productInterest String @default("")
 productModel String @default("")
 purchaseType String @default("OTHER")
 quantity Int? @default(0)
 budget Decimal @default(0)
 estimatedOrderValue Decimal @default(0)
 currency String @default("CNY")
 purchaseTimeline String @default("")
 shippingCountry String @default("")
 shippingCity String @default("")
 shippingPostalCode String @default("")
 stage String @default("NEW")
 isQualified Boolean?
 invalidReason String @default("")
 ownerId String
 owner User @relation(fields: [ownerId], references: [id])
 contactedAt DateTime?
 firstReplyAt DateTime?
 needsConfirmedAt DateTime?
 quotedAt DateTime?
 quotedAmount Decimal @default(0)
 wonAt DateTime?
 lostAt DateTime?
 lastFollowUpAt DateTime?
 nextFollowUpAt DateTime?
 aiScore Int @default(0)
 aiPriority String @default("UNRANKED")
 aiIntent String @default("UNKNOWN")
 aiSummary String @default("")
 aiNextAction String @default("")
 aiReason String @default("")
 aiRisk String @default("")
 aiLastAnalyzedAt DateTime?
 lastContactAt DateTime?
 lastWhatsAppAt DateTime?
 lastInboundAt DateTime?
 lastOutboundAt DateTime?
 notes String @default("")
 createdAt DateTime @default(now())
 inquiryAt DateTime?
 updatedAt DateTime @updatedAt
 deletedAt DateTime?
 followUps FollowUp[]
 stageHistory StageHistory[]
 deals Deal[]
 submissions LeadSubmission[]
 whatsappMessages WhatsAppMessage[]
 tasks Task[]
 quotations Quotation[]
 workflowEvents WorkflowEvent[]
 mediaAssets MediaAsset[]
 readStates WhatsAppReadState[]
 intelligence CustomerIntelligence?
 orders Order[]
 metaLeadEvents MetaLeadEvent[]
 @@index([stage])
 @@index([source])
 @@index([country])
 @@index([ownerId])
 @@index([createdAt])
 @@index([inquiryAt])
 @@index([nextFollowUpAt])
 @@index([isQualified])
 @@index([email])
 @@index([phone])
 @@index([whatsapp])
 @@index([whatsappNormalized])
 @@index([waId])
 @@index([aiScore])
 @@index([aiPriority])
 @@index([lastWhatsAppAt])
}
model FollowUp {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 type String
 content String
 followUpAt DateTime
 nextFollowUpAt DateTime?
 createdBy String
 createdAt DateTime @default(now())
 @@index([customerId, followUpAt])
}
model StageHistory {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 fromStage String?
 toStage String
 changedAt DateTime @default(now())
 changedBy String
 note String @default("")
 @@index([customerId, changedAt])
}
model Deal {
 id String @id @default(cuid())
 order Order?
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 orderNumber String @default("")
 dealAmount Decimal
 productCost Decimal
 grossProfit Decimal
 grossMargin Decimal
 currency String @default("CNY")
 product String @default("")
 productModel String @default("")
 quantity Int @default(0)
 notes String @default("")
 dealDate DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([dealDate])
 @@index([customerId])
}
model SalesTarget {
 id String @id @default(cuid())
 periodKey String @unique
 periodType String
 year Int
 month Int?
 week Int?
 targetRevenue Decimal
 manual Boolean @default(false)
 currency String @default("CNY")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Setting {
 id String @id @default("system")
 companyName String @default("木远家具贸易")
 currency String @default("CNY")
 timezone String @default("Asia/Shanghai")
 // 美元/人民币汇率。默认 6.70 取自 2026 中英文两份报价表之间的隐含汇率（54 组中 44 组精确为 6.70）。
 usdCnyRate Decimal @default(6.70) @db.Decimal(10, 4)
}

model LeadSubmission {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 eventKey String @unique
 leadId String @default("")
 ordinal Int
 occurredAt DateTime
 values String @db.LongText
 raw String @db.LongText
 filename String
 fileHash String
 translationPending String @db.Text
 createdAt DateTime @default(now())
 @@unique([customerId, ordinal])
 @@index([customerId, occurredAt])
}

model WhatsAppMessage {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 waMessageId String? @unique
 requestId String? @unique
 providerMessageId String? @unique
 sender String @default("")
 waId String @default("")
 direction String
 messageType String @default("TEXT")
 content String @map("text") @db.Text
 mediaUrl String? @db.Text
 mimeType String?
 fileName String?
 status String @default("")
 sentAt DateTime
 raw String @db.LongText
 aiProcessedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([customerId, sentAt])
 @@index([waId])
}

model CustomerIntelligence {
 id String @id @default(cuid())
 customerId String @unique
 customer Customer @relation(fields: [customerId], references: [id])
 score Int @default(0)
 priority String @default("UNRANKED")
 intent String @default("UNKNOWN")
 customerType String @default("UNKNOWN")
 productsJson String @db.Text
 quantity Int?
 currentNeed String @default("")
 mainObjection String @default("")
 suggestedStage String @default("")
 nextAction String @default("")
 reason String @default("")
 risk String @default("")
 confidence Int @default(0)
 lastMessageAt DateTime?
 analyzedAt DateTime?
 updatedAt DateTime @updatedAt
 @@index([priority])
 @@index([score])
 @@index([intent])
}

model MetaImportRun {
 id String @id
 userId String
 result String
 createdAt DateTime @default(now())
}

model TranslationSetting {
 id String @id @default("meta")
 endpoint String @default("")
 encryptedKey String @default("")
}

model WhatsAppIntegration {
 id String @id @default("primary")
 status String @default("DISCONNECTED")
 connectionMode String @default("COEXISTENCE")
 businessId String @default("")
 wabaId String @default("")
 phoneNumberId String @default("")
 displayPhoneNumber String @default("")
 verifiedName String @default("")
 encryptedAccessToken String @db.LongText
 tokenExpiresAt DateTime?
 scopes String @db.Text
 subscribedAt DateTime?
 connectedAt DateTime?
 lastVerifiedAt DateTime?
 lastError String @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([wabaId])
 @@index([phoneNumberId])
}

model Task {
 id String @id @default(cuid())
 customerId String?
 customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
 title String
 description String @db.Text
 type String @default("FOLLOW_UP")
 priority String @default("MEDIUM")
 status String @default("TODO")
 dueDate DateTime
 completedAt DateTime?
 createdBy String
 source String @default("MANUAL")
 automationKey String? @unique
 // 任务必须能追溯到业务对象：客户已有，这里补订单、金额与 AI 生成理由
 orderId String?
 order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
 amount Decimal? @db.Decimal(14, 2)
 aiReason String? @db.Text
 deletedAt DateTime?
 reminderMinutes Int @default(30)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 reminders Reminder[]
 @@index([createdBy, status, dueDate])
 @@index([customerId, status])
 @@index([status, dueDate])
}
model Reminder {
 id String @id @default(cuid())
 taskId String
 task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
 remindAt DateTime
 status String @default("PENDING")
 kind String @default("EARLY")
 createdAt DateTime @default(now())
 @@unique([taskId, kind])
 @@index([status, remindAt])
}
model WhatsAppReadState {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 userId String
 readAt DateTime
 @@unique([customerId, userId])
}
model Order {
 id String @id @default(cuid())
 orderNo String @unique @db.VarChar(40)
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 // 一笔成交对应一张订单；复购会产生新成交，因而产生新订单。唯一约束用于幂等。
 dealId String? @unique
 deal Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
 // 金额统一以人民币展示；原币种与原币金额保留，便于核对换算来源
 amountRMB Decimal @db.Decimal(14, 2)
 currency String @default("CNY") @db.VarChar(3)
 sourceAmount Decimal? @db.Decimal(14, 2)
 // 流程固定七段：下单 → 付款 → 生产 → 发货 → 运输 → 清关 → 收货
 // status 决定状态页签；进度条由 status 推导，不另存冗余字段以免不一致
 status String @default("PENDING_PAYMENT") @db.VarChar(24)
 paymentStatus String @default("UNPAID") @db.VarChar(24)
 productionStatus String @default("NOT_STARTED") @db.VarChar(24)
 shippingStatus String @default("NOT_SHIPPED") @db.VarChar(24)
 orderDate DateTime @default(now())
 estimatedDelivery DateTime?
 notes String @db.Text
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tasks Task[]
 @@index([customerId, status])
 @@index([status, orderDate])
 @@index([estimatedDelivery])
}

model Quotation {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 quoteNumber String @unique
 product String
 quantity Int
 unitPrice Decimal @db.Decimal(14, 2)
 currency String
 incoterm String
 notes String @db.Text
 status String @default("DRAFT")
 sentAt DateTime?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([customerId, createdAt])
}
model WorkflowEvent {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 kind String
 happenedAt DateTime
 expectedAt DateTime?
 description String @db.Text
 requestId String @unique
 createdBy String
 createdAt DateTime @default(now())
 @@index([customerId, happenedAt])
}
model MediaAsset {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 createdBy String
 fileName String
 mimeType String
 storageKey String @unique
 size Int
 createdAt DateTime @default(now())
 @@index([customerId])
}

// BOS growth foundation. No external ad accounts are connected in Core v1.
model LeadSource {
 id String @id @default(cuid())
 name String
 channel String
 externalId String?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 campaigns Campaign[]
 @@index([createdBy, channel])
}
model Campaign {
 id String @id @default(cuid())
 name String
 channel String
 externalId String?
 sourceId String?
 source LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
 currency String @default("USD")
 status String @default("DRAFT")
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 metrics MarketingMetric[]
 @@index([createdBy, channel])
 @@index([sourceId])
}
model MarketingMetric {
 id String @id @default(cuid())
 campaignId String
 campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
 metricDate DateTime @db.Date
 spend Decimal @db.Decimal(14, 2)
 impressions Int @default(0)
 clicks Int @default(0)
 leads Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([campaignId, metricDate])
 @@index([metricDate])
}

// ═══════════════════════════════════════════════════════════
// Product OS — 产品中心（V1）
// 加性变更：仅新增表，不修改任何现有表结构。
// 权威规则（业务确认 2026-09-22）：
//   - 规格 / 包装 / CBM / 毛重 / 价格 一律以报价表为准
//   - 报价为 FOB；MOQ 按渠道分档（线上 10 / 线下 20）
// ═══════════════════════════════════════════════════════════

model ProductCategory {
  id String @id @default(cuid())
  code String @unique @db.VarChar(32)
  nameEn String
  nameCn String @default("")
  level Int @default(1)
  codePrefix String @default("") @db.VarChar(4)
  sort Int @default(0)
  createdAt DateTime @default(now())
  parentId String?
  parent ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  @@index([parentId])
  @@index([level, sort])
}

model ProductSeries {
  id String @id @default(cuid())
  code String @unique @db.VarChar(32)
  nameEn String
  nameCn String @default("")
  descriptionEn String @db.Text
  descriptionCn String @db.Text
  sort Int @default(0)
  createdAt DateTime @default(now())
  products Product[]
}

model Product {
  id String @id @default(cuid())
  model String @unique @db.VarChar(64)
  nameEn String
  nameCn String @default("")
  categoryId String
  category ProductCategory @relation(fields: [categoryId], references: [id])
  seriesId String?
  series ProductSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  status String @default("ACTIVE") @db.VarChar(16)
  lengthLabel String @default("")
  isModular Boolean @default(false)
  isSofaBed Boolean @default(false)
  seatCount Int?
  pillowCount Int?
  backrestCount Int?
  leadTimeDays Int @default(15)
  qaMonths Int @default(12)
  descriptionEn String @db.Text
  descriptionCn String @db.Text
  createdBy String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants ProductVariant[]
  materials ProductMaterial[]
  options ProductOption[]
  moqs ProductMoq[]
  media ProductMedia[]
  aiProfile ProductAiProfile?
  @@index([categoryId, status])
  @@index([seriesId])
  @@index([deletedAt])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku String @unique @db.VarChar(80)
  variantType String @default("CONFIGURATION") @db.VarChar(16)
  labelEn String @default("")
  labelCn String @default("")
  lengthCm Int?
  widthCm Int?
  heightCm Int?
  secondaryLabelEn String @default("")
  secondaryLabelCn String @default("")
  secondaryLengthCm Int?
  secondaryWidthCm Int?
  secondaryHeightCm Int?
  bedSizeCm String @default("")
  packingRaw String @default("")
  cartonCount Int @default(1)
  cbm Decimal @db.Decimal(8, 4) @default(0)
  cbmComputed Decimal? @db.Decimal(8, 4)
  grossWeightKg Decimal @db.Decimal(8, 2) @default(0)
  grossWeightRaw String @default("")
  needsReview Boolean @default(false)
  reviewNote String @db.Text
  status String @default("ACTIVE") @db.VarChar(16)
  createdBy String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cartons PackingCarton[]
  prices ProductPrice[]
  media ProductMedia[]
  costs ProductCost[]
  @@index([productId, status])
  @@index([deletedAt])
  @@index([needsReview])
}

model PackingCarton {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  label String @default("")
  lengthCm Int
  widthCm Int
  heightCm Int
  cartonCount Int @default(1)
  piecesPerCarton Int @default(1)
  grossWeightKg Decimal? @db.Decimal(8, 2)
  sort Int @default(0)
  @@index([variantId, sort])
}

model ProductMaterial {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  role String @db.VarChar(16)
  nameEn String
  nameCn String @default("")
  specEn String @default("")
  sort Int @default(0)
  @@index([productId, role])
}

model ProductOption {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind String @db.VarChar(16)
  code String @default("")
  nameEn String
  nameCn String @default("")
  isDefault Boolean @default(false)
  sort Int @default(0)
  @@index([productId, kind])
}

model ProductMoq {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel String @db.VarChar(24)
  channelLabelCn String @default("")
  minQty Int
  note String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, channel])
  @@index([channel])
}

model ProductPrice {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceListKey String @default("LVANJU-2026") @db.VarChar(24)
  currency String @default("USD") @db.VarChar(3)
  incoterm String @default("FOB") @db.VarChar(8)
  includesFreight Boolean @default(false)
  customerTier String @default("ALL") @db.VarChar(24)
  minQty Int @default(1)
  maxQty Int?
  unitPrice Decimal @db.Decimal(14, 2)
  cost Decimal? @db.Decimal(14, 2)
  effectiveFrom DateTime
  effectiveTo DateTime?
  status String @default("ACTIVE") @db.VarChar(16)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([variantId, priceListKey, currency, incoterm, customerTier, minQty])
  @@index([variantId, status])
  @@index([effectiveFrom])
}

model ProductMedia {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  role String @default("GALLERY") @db.VarChar(16)
  storageKey String @unique
  mimeType String
  fileName String
  width Int?
  height Int?
  size Int
  sort Int @default(0)
  createdBy String
  createdAt DateTime @default(now())
  @@index([productId, role])
  @@index([variantId])
}

model ProductAiProfile {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingPointsJson String @db.Text
  advantagesJson String @db.Text
  useCasesJson String @db.Text
  bestCustomerJson String @db.Text
  recommendedMarketJson String @db.Text
  keywordsJson String @db.Text
  searchText String @db.Text
  status String @default("DRAFT") @db.VarChar(16)
  reviewedBy String?
  reviewedAt DateTime?
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// 产品成本与毛利
//
// 工厂成本与采购成本是**两种供货方式**，不是相加的分项：
//   - 工厂成本：我们自己工厂做出来的基本成本
//   - 采购成本：从其他工厂采购同款的价格
// 每个尺寸变体通常只会填其中一个（没做的产品就是外购的）。
//
// 成本不含国内运费与报关，因此算出来的是「生产毛利」，界面须如实标注。
// 成本属于敏感数据：所有读写接口仅限管理员，且不得出现在非管理员的产品查询结果中。
// ═══════════════════════════════════════════════════════════
model ProductCost {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currency String @default("CNY") @db.VarChar(3)
  factoryCost Decimal? @db.Decimal(14, 2)
  purchaseCost Decimal? @db.Decimal(14, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  status String @default("ACTIVE") @db.VarChar(16)
  note String @db.Text
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([variantId, status])
  @@index([effectiveFrom])
}

// ═══════════════════════════════════════════════════════════
// Meta Facebook Lead Ads 事件
//
// Meta 会重复推送同一个 leadgen_id（重试、订阅重复等）。
// leadgenId 唯一约束是幂等键：同一个线索只会建一次客户。
// 与 LeadSubmission 区分：那张表服务于「Meta CSV 导入」（有 filename/fileHash/行号），
// 这里服务于 webhook 推送，两者的语义与生命周期都不同。
// ═══════════════════════════════════════════════════════════
model MetaLeadEvent {
 id String @id @default(cuid())
 leadgenId String @unique
 pageId String @default("")
 formId String @default("")
 customerId String?
 customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
 // 原始推送内容，便于事后追溯广告来源与表单答案
 rawPayload Json
 // RECEIVED | CREATED | LINKED | SKIPPED | FAILED
 status String @default("RECEIVED") @db.VarChar(16)
 error String @db.Text
 createdAt DateTime @default(now())
 @@index([formId, createdAt])
 @@index([customerId])
 @@index([status, createdAt])
}
