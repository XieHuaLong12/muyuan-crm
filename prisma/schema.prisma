 @@index([templateName])
}

// 系统分配：同一触达位置、等级、语言下轮流分配话术，业务员只负责发送。
model OutreachAssignment {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 position String @db.VarChar(4)
 // 第几轮：破冰为 0，每次进入沉默期加 1（唤醒可以有多轮）
 cycle Int @default(0)
 scriptId String
 script OutreachScript @relation(fields: [scriptId], references: [id], onDelete: Restrict)
 grade String @default("") @db.VarChar(1)
 language String @db.VarChar(4)
 assignedAt DateTime @default(now())
 // 按分配发出后回填
 touchId String? @unique
 @@unique([customerId, position, cycle])
 @@index([scriptId])
 @@index([position, grade, language])
}

// 触达记录：每发一组主动消息（10 分钟内连发的算一组）一行。
model OutreachTouch {
 id String @id @default(cuid())
 // 组内第一条消息的 id，幂等键
 groupKey String @unique @db.VarChar(191)
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 // ICEBREAK 破冰触达 | REVIVE 唤醒触达
 kind String @db.VarChar(8)
 // T0–T4 | R1–R3
 code String @db.VarChar(4)
 cycle Int @default(0)
 scriptId String?
 script OutreachScript? @relation(fields: [scriptId], references: [id], onDelete: SetNull)
 // EXACT 原样 | LIGHT 轻改 | HEAVY 大幅改写 | FREE 自由发挥；空表示还没判
 matchType String @default("") @db.VarChar(8)
 confidence Decimal? @db.Decimal(4, 3)
 // 消息意图 GREETING | PRODUCT | QUOTE | ANSWER | SAMPLE | NUDGE | OTHER
 intent String @default("") @db.VarChar(12)
 // PENDING 待判定 | DONE | REVIEW 待人工复核
 judgeStatus String @default("PENDING") @db.VarChar(12)
 // RULE | AI | HUMAN
 judgedBy String @default("") @db.VarChar(8)
 judgeReason String @default("") @db.VarChar(500)
 judgedAt DateTime?
 senderId String?
 sentAt DateTime
 // BOS_FREE | BOS_TEMPLATE | PHONE
 channel String @db.VarChar(16)
 windowOpen Boolean @default(false)
 // 发送时的客户等级与话术语言（快照，统计按它分组）
 grade String @default("") @db.VarChar(1)
 language String @default("") @db.VarChar(4)
 // 距上一次主动触达不足 24 小时
 tooSoon Boolean @default(false)
 // 计入统计的那组回复（冗余一份，统计不用联表）；replied24h 为空表示还没满 24 小时
 replyId String? @unique
 repliedAt DateTime?
 replied24h Boolean?
 lateReply Boolean @default(false)
 replyQuality String @default("") @db.VarChar(12)
 replySignals Json?
 text String @db.Text
 contentHash String @db.Char(64)
 messageCount Int @default(1)
 humanEdited Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 overrides OutreachOverride[]
 @@index([customerId, sentAt])
 @@index([code, sentAt])
 @@index([scriptId, sentAt])
 @@index([judgeStatus])
 @@index([senderId, sentAt])
}

// 回复判定：客户每组回复（10 分钟内连发的算一组）一行，由 DeepSeek 判定质量与信号。
model OutreachReply {
 id String @id @default(cuid())
 groupKey String @unique @db.VarChar(191)
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 // 计入哪条触达：只有破冰 / 唤醒触达之后的第一组有效回复才有
 touchId String?
 receivedAt DateTime
 // HIGH 高意向 | ENGAGED 有效互动 | LOW 低意向 | REJECT 拒绝 | INVALID 无效
 quality String @default("") @db.VarChar(12)
 signals Json?
 // 含图片或语音，需要业务员看完或听完后改判
 needsHuman Boolean @default(false)
 gradeSuggestion String @default("") @db.VarChar(1)
 // PENDING | ACCEPTED | DISMISSED
 gradeSuggestionStatus String @default("") @db.VarChar(12)
 nextStep String @default("") @db.VarChar(300)
 reason String @default("") @db.VarChar(500)
 // PENDING 待 AI 判定（已有规则临时结果）| DONE | REVIEW
 judgeStatus String @default("PENDING") @db.VarChar(12)
 // RULE | AI | BUTTON | HUMAN
 judgedBy String @default("") @db.VarChar(8)
 judgedAt DateTime?
 text String @db.Text
 contentHash String @db.Char(64)
 messageCount Int @default(1)
 humanEdited Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 overrides OutreachOverride[]
 @@index([customerId, receivedAt])
 @@index([touchId])
 @@index([judgeStatus])
 @@index([quality, receivedAt])
}

// 判定修改记录：人工改一次记一行。统计一律按改后的结果，原值保留不删。
model OutreachOverride {
 id String @id @default(cuid())
 touchId String?
 touch OutreachTouch? @relation(fields: [touchId], references: [id], onDelete: Cascade)
 replyId String?
 reply OutreachReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
 // SCRIPT 话术编号 | MATCH_TYPE 匹配类型 | QUALITY 回复质量 | SIGNALS 信号标签 | GRADE 等级建议
 field String @db.VarChar(16)
 oldValue String @db.Text
 newValue String @db.Text
 // VOICE_IMAGE 语音或图片人工判定 | AI_WRONG AI 判错 | CONTEXT 补充了上下文 | OTHER 其他
 reason String @db.VarChar(16)
 note String @default("") @db.VarChar(500)
 // 原值是不是 DeepSeek 给的（改判率只算这些）
 aiOriginal Boolean @default(false)
 actorId String
 createdAt DateTime @default(now())
 @@index([touchId])
 @@index([replyId])
 @@index([createdAt])
}

// 每周一自动生成的话术结论（上周为止的累计数据）。
model OutreachReport {
 id String @id @default(cuid())
 weekStart String @unique @db.VarChar(10)
 lines Json
 generatedAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// 工作日历：月重心 → 周重心 → 今日三件事
// ═══════════════════════════════════════════════════════════

// 月重心 / 周重心：每层每期最多 3 条；周重心必须关联月重心。全公司共用。
model FocusGoal {
 id String @id @default(cuid())
 // MONTH | WEEK
 level String @db.VarChar(8)
 // 月：2026-10；周：该周周一 2026-10-19
 periodKey String @db.VarChar(10)
 title String @db.VarChar(200)
 // 目标值，文字描述，如「10 位客户到厂」
 target String @default("") @db.VarChar(200)
 // 进度 0–100
 progress Int @default(0)
 // 数字目标（可选），如 10 位：填了目标数时，进度按 当前数 ÷ 目标数 计算，复盘里可以 +1 / −1
 targetValue Int?
 currentValue Int @default(0)
 unit String @default("") @db.VarChar(8)
 parentId String?
 parent FocusGoal? @relation("FocusTree", fields: [parentId], references: [id], onDelete: SetNull)
 children FocusGoal[] @relation("FocusTree")
 // 周重心完成情况：TODO 未开始 | DOING 进行中 | DONE 已完成
 status String @default("TODO") @db.VarChar(8)
 // CONVERT 转化 | FRONTEND 前端 | DATA 数据
 category String @default("CONVERT") @db.VarChar(12)
 sort Int @default(0)
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 items WorkItem[]
 progressLogs FocusProgressLog[]
 @@index([level, periodKey])
}

// 日历事项：手动事项、周重心下的任务、固定事项、时间块、重点事件。没做完的第二天自动顺延。
model WorkItem {
 id String @id @default(cuid())
 userId String
 // 本地日期 yyyy-MM-dd
 date String @db.VarChar(10)
 // 多日的重点事件（如广交会）结束日期
 endDate String? @db.VarChar(10)
 title String @db.VarChar(200)
 detail String @default("") @db.VarChar(1000)
 // MANUAL | FOCUS | FIXED | TIMEBLOCK | EVENT
 kind String @default("MANUAL") @db.VarChar(12)
 category String @default("CONVERT") @db.VarChar(12)
 focusId String?
 focus FocusGoal? @relation(fields: [focusId], references: [id], onDelete: SetNull)
 startTime String? @db.VarChar(5)
 endTime String? @db.VarChar(5)
 // 1 放进今日三件事 | -1 移出 | 0 按顺序自动
 pin Int @default(0)
 // 今日三件事的位置 1–3，空 = 不在三件事里。头天晚上复盘时排好，或当天开工时按顺序定下；做完仍留在三件事里
 topOrder Int?
 // TODO | DONE | DROPPED（复盘时选了不做了，或删除系统排的事项）
 status String @default("TODO") @db.VarChar(8)
 doneAt DateTime?
 carryCount Int @default(0)
 originalDate String? @db.VarChar(10)
 // 自动生成的事项去重（固定事项、时间块、预置事件）
 sourceKey String? @db.VarChar(120)
 href String? @db.VarChar(300)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([userId, date, sourceKey])
 @@index([userId, date])
 @@index([userId, status, date])
 @@index([kind, date])
}

// 每日时间块模板（北京时间），每天生成当天的时间块事项。
model TimeBlock {
 id String @id @default(cuid())
 userId String
 startTime String @db.VarChar(5)
 endTime String @db.VarChar(5)
 title String @db.VarChar(200)
 category String @default("CONVERT") @db.VarChar(12)
 // 适用的星期，1–7（周一到周日），逗号分隔
 weekdays String @default("1,2,3,4,5") @db.VarChar(16)
 sort Int @default(0)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId, active])
}

// 每日复盘（docs/OUTREACH_AND_WORKBENCH.md）：每人每天一条，只有本人可见。提交后仍可修改，每次修改记一条 DailyReviewRevision。
model DailyReview {
 id String @id @default(cuid())
 userId String
 // 本地日期 yyyy-MM-dd
 date String @db.VarChar(10)
 // DRAFT 草稿 | SUBMITTED 已提交 | REST 休息 | MISSED 没复盘（第二天开工时按当天的勾选记下）
 status String @default("DRAFT") @db.VarChar(10)
 // 当天三件事和结果：[{ itemId, title, category, focusTitle, carryCount, outcome: DONE | CARRIED | DROPPED, reason, note }]
 items Json
 // 三件事完成数 / 件数、顺延、不做了
 done Int @default(0)
 planned Int @default(0)
 carried Int @default(0)
 dropped Int @default(0)
 // 复盘三问：做得好的、遇到的问题和原因、明天只改进一件事
 wins String @default("") @db.VarChar(1000)
 problems String @default("") @db.VarChar(1000)
 improvement String @default("") @db.VarChar(200)
 // 前一天写下的改进今天做到了吗：YES | PARTLY | NO
 lastImprovement String? @db.VarChar(8)
 // 精力、专注 1–5
 energy Int?
 focusLevel Int?
 // 排好的明天三件事：[{ itemId, title, category, startTime, endTime }]
 plan Json
 // 当天的数据，随复盘存档：新线索、首回、客户回复、报价
 metrics Json?
 submittedAt DateTime?
 // 21:30 复盘提醒已发
 remindedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 revisions DailyReviewRevision[]
 @@unique([userId, date])
 @@index([userId, status, date])
}

// 复盘的每一次提交和修改：改了什么、改之前、改之后。只增不改。
model DailyReviewRevision {
 id String @id @default(cuid())
 reviewId String
 review DailyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
 // SUBMIT 提交 | EDIT 提交后修改 | REST 标为休息
 kind String @db.VarChar(8)
 // [{ field, label, before, after }]
 changes Json
 createdAt DateTime @default(now())
 @@index([reviewId, createdAt])
}

// 重心进度的每一次变化：哪天、谁、从多少到多少。只增不改。
model FocusProgressLog {
 id String @id @default(cuid())
 focusId String
 focus FocusGoal @relation(fields: [focusId], references: [id], onDelete: Cascade)
 userId String
 // 本地日期 yyyy-MM-dd
 date String @db.VarChar(10)
 fromValue Int
 toValue Int
 // 当时的目标数；空 = 按百分比记录
 target Int?
 createdAt DateTime @default(now())
 @@index([focusId, createdAt])
 @@index([date])
}

// ═══════════════════════════════════════════════════════════
// 客户雷达 · 开发信（docs/CUSTOMER_RADAR_COLD_EMAIL.md）
// 独立的获客数据域：爬到的公司、邮箱、发信与回复都在 Radar* 表里，不进 Customer；只有有效回复才建客户。
// ═══════════════════════════════════════════════════════════

// 关键词 × 城市：爬虫每天取最久没跑过的若干条，避免每天重复跑全量。
model RadarSearch {
 id String @id @default(cuid())
 // ISO 国家代码：FR | AE | SA | AU
 country String @db.VarChar(2)
 city String @db.VarChar(120)
 keyword String @db.VarChar(120)
 active Boolean @default(true)
 lastRunAt DateTime?
 // 上次地图结果数 / 新入库数
 lastFound Int @default(0)
 lastNew Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 prospects RadarProspect[]
 @@unique([country, city, keyword])
 @@index([active, lastRunAt])
}

// 雷达客户：地图上找到的每家公司一行。按 placeKey 幂等入库，按域名、电话、公司名 + 城市去重。
model RadarProspect {
 id String @id @default(cuid())
 // Google 地图商家编号
 placeKey String @unique @db.VarChar(191)
 name String @db.VarChar(300)
 // 规范化的「公司名|城市」，去重用
 nameCityKey String @db.VarChar(191)
 country String @db.VarChar(2)
 city String @default("") @db.VarChar(120)
 // IANA 时区，按国家 + 城市从配置取，发信时段按它算
 timezone String @db.VarChar(40)
 address String @default("") @db.VarChar(500)
 website String @default("") @db.VarChar(500)
 // 规范化域名（去掉 www.）；免费邮箱和社媒域名为空
 domain String @default("") @db.VarChar(191)
 phone String @default("") @db.VarChar(40)
 phoneE164 String? @db.VarChar(16)
 whatsapp String @default("") @db.VarChar(40)
 // { facebook, instagram, linkedin, tiktok, youtube }
 socials Json?
 mapsCategory String @default("") @db.VarChar(200)
 rating Decimal? @db.Decimal(2, 1)
 reviewCount Int?
 // 官网首页、联系页、关于页的文字（截到 4000 字），给 AI 评分和写开头用
 siteText String? @db.Text
 // WHOLESALER 批发商 | IMPORTER 进口商 | FURNITURE_STORE 家具店 | MATTRESS_STORE 床垫店 | OTHER 其他 | UNRELATED 不相关；空 = 未评
 customerType String @default("") @db.VarChar(16)
 mainProducts String @default("") @db.VarChar(500)
 aiReason String @default("") @db.VarChar(500)
 // { type, category, scale, contactability, intent }：客户类型 40、品类匹配 20、规模 15、可联系度 15（规则算）、意向信号 10
 scoreParts Json?
 score Int?
 // A | B | C；空 = 未评
 grade String @default("") @db.VarChar(1)
 // 1–2 条官网细节 [{ fact, quote }]，quote 必须是官网原文；个性化开头只能用这里的内容
 siteFacts Json?
 scoredAt DateTime?
 scoreAttempts Int @default(0)
 scoreError String @default("") @db.VarChar(300)
 keyword String @default("") @db.VarChar(120)
 searchId String?
 search RadarSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)
 discoveredAt DateTime @default(now())
 // NEW 新发现 | NO_EMAIL 无邮箱 | CONTACTED 已联系（其他渠道）| EXCLUDED 已排除；发信相关状态见 lib/radar.ts
 status String @default("NEW") @db.VarChar(16)
 statusAt DateTime @default(now())
 excludedReason String @default("") @db.VarChar(200)
 notes String @default("") @db.VarChar(1000)
 // 有效回复推进 BOS 后的客户
 customerId String?
 customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 emails RadarEmail[]
 @@index([status, grade, score])
 @@index([country, status])
 @@index([domain])
 @@index([phoneE164])
 @@index([nameCityKey])
 @@index([discoveredAt])
 @@index([scoredAt])
 @@index([customerId])
}

// 雷达客户的邮箱，每个地址一行，带验证结果与退信记录。
model RadarEmail {
 id String @id @default(cuid())
 prospectId String
 prospect RadarProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
 // 小写
 address String @db.VarChar(191)
 // DIRECT 直达（人名、achat@ 等采购地址）| GENERIC 通用（contact@、info@）
 kind String @db.VarChar(8)
 // WEBSITE 官网 | MAPS 地图 | REPLY 回信里给的新联系人 | MANUAL 手动
 source String @default("WEBSITE") @db.VarChar(8)
 // 在哪个网页找到的（GDPR：记录数据来源）
 foundOn String @default("") @db.VarChar(500)
 // 空 = 未验证 | VALID 有效 | RISKY 风险（全收、临时邮箱）| INVALID 无效 | UNKNOWN 验证失败，稍后重试
 verifyStatus String @default("") @db.VarChar(8)
 verifyDetail String @default("") @db.VarChar(200)
 verifiedAt DateTime?
 verifyAttempts Int @default(0)
 bouncedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([prospectId, address])
 @@index([address])
 @@index([verifyStatus])
}
