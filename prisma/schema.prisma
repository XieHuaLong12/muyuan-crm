generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "mysql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 role String @default("SALES")
 isActive Boolean @default(true)
 sessionVersion Int @default(0)
 createdAt DateTime @default(now())
 customers Customer[]
 salesTargets UserSalesTarget[]
 pushSubscriptions PushSubscription[]
}
model Customer {
 id String @id @default(cuid())
 name String
 companyName String @default("")
 country String @default("")
 countryCode String @default("")
 city String @default("")
 phone String @default("")
 whatsapp String @default("")
 whatsappNormalized String @default("")
 phoneE164 String? @db.VarChar(16)
 emailNormalized String? @db.VarChar(191)
 // 联系方式规范键（phoneE164 / emailNormalized / ContactIdentity）首次计算时间；为空表示尚未计算的历史客户，查重时在内存中比对。
 contactKeysAt DateTime?
 stageSource String @default("HUMAN") @db.VarChar(16)
 waId String?
 email String @default("")
 source String @default("OTHER")
 sourceDetail String @default("")
 language String @default("")
 productInterest String @default("")
 productModel String @default("")
 purchaseType String @default("OTHER")
 quantity Int? @default(0)
 budget Decimal @default(0)
 estimatedOrderValue Decimal @default(0)
 currency String @default("CNY")
 purchaseTimeline String @default("")
 shippingCountry String @default("")
 shippingCity String @default("")
 shippingPostalCode String @default("")
 stage String @default("NEW")
 isQualified Boolean?
 invalidReason String @default("")
 ownerId String
 owner User @relation(fields: [ownerId], references: [id])
 // 自动进入的线索在被分配给具体负责人之前处于待分配池；ownerId 暂为收件管理员。
 pendingAssignment Boolean @default(false)
 assignedAt DateTime?
 firstContactDueAt DateTime?
 firstContactAt DateTime?
 firstContactBy String?
 contactedAt DateTime?
 firstReplyAt DateTime?
 needsConfirmedAt DateTime?
 quotedAt DateTime?
 quotedAmount Decimal @default(0)
 wonAt DateTime?
 lostAt DateTime?
 lastFollowUpAt DateTime?
 nextFollowUpAt DateTime?
 aiScore Int @default(0)
 aiPriority String @default("UNRANKED")
 aiIntent String @default("UNKNOWN")
 aiSummary String @default("")
 aiNextAction String @default("")
 aiReason String @default("")
 aiRisk String @default("")
 aiLastAnalyzedAt DateTime?
 // 广告表单等级 A/B/C/D：入库时按表单答案评定（DeepSeek，未配置或失败时按规则），空字符串表示尚未评级。
 leadGrade String @default("") @db.VarChar(1)
 leadGradeReason String @default("") @db.VarChar(500)
 // AI | RULE
 leadGradeSource String @default("") @db.VarChar(8)
 leadGradedAt DateTime?
 lastContactAt DateTime?
 lastWhatsAppAt DateTime?
 lastInboundAt DateTime?
 lastOutboundAt DateTime?
 whatsappOptInStatus String @default("UNKNOWN") @db.VarChar(16)
 whatsappOptInSource String? @db.VarChar(24)
 whatsappOptInEvidence String? @db.Text
 whatsappOptInAt DateTime?
 whatsappOptOutAt DateTime?
 notes String @default("") @db.Text
 createdAt DateTime @default(now())
 inquiryAt DateTime?
 updatedAt DateTime @updatedAt
 deletedAt DateTime?
 followUps FollowUp[]
 stageHistory StageHistory[]
 deals Deal[]
 submissions LeadSubmission[]
 whatsappMessages WhatsAppMessage[]
 tasks Task[]
 quotations Quotation[]
 workflowEvents WorkflowEvent[]
 mediaAssets MediaAsset[]
 readStates WhatsAppReadState[]
 intelligence CustomerIntelligence?
 orders Order[]
 metaLeadEvents MetaLeadEvent[]
 contactIdentities ContactIdentity[]
 leadAttributions CustomerLeadAttribution[]
 whatsappContacts WhatsAppContact[]
 advertisingFeedback AdvertisingFeedback[]
 assignments CustomerAssignment[]
 leadAlerts LeadAlert[]
 @@index([stage])
 @@index([source])
 @@index([country])
 @@index([ownerId])
 @@index([firstContactDueAt])
 @@index([pendingAssignment])
 @@index([contactKeysAt])
 @@index([createdAt])
 @@index([inquiryAt])
 @@index([nextFollowUpAt])
 @@index([isQualified])
 @@index([email])
 @@index([phone])
 @@index([whatsapp])
 @@index([whatsappNormalized])
 @@index([phoneE164])
 @@index([emailNormalized])
 @@index([waId])
 @@index([aiScore])
 @@index([leadGrade])
 @@index([aiPriority])
 @@index([lastWhatsAppAt])
 @@index([whatsappOptInStatus])
}
model FollowUp {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 type String
 content String
 followUpAt DateTime
 nextFollowUpAt DateTime?
 createdBy String
 createdAt DateTime @default(now())
 @@index([customerId, followUpAt])
}
model StageHistory {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 fromStage String?
 toStage String
 changedAt DateTime @default(now())
 changedBy String
 note String @default("")
 @@index([customerId, changedAt])
}
model Deal {
 id String @id @default(cuid())
 order Order?
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 salespersonId String?
 orderNumber String @default("")
 dealAmount Decimal
 productCost Decimal
 grossProfit Decimal
 grossMargin Decimal
 currency String @default("CNY")
 product String @default("")
 productModel String @default("")
 quantity Int @default(0)
 notes String @default("")
 dealDate DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([dealDate])
 @@index([customerId])
 @@index([salespersonId, dealDate])
}
model UserSalesTarget {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id])
 month String @db.VarChar(7)
 currency String @db.VarChar(3)
 targetRevenue Decimal @db.Decimal(14, 2)
 updatedAt DateTime @updatedAt
 createdAt DateTime @default(now())
 @@unique([userId, month, currency])
 @@index([month])
}
model CustomerAssignment {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 fromOwnerId String?
 toOwnerId String
 actorId String
 reason String @db.VarChar(500)
 assignedAt DateTime @default(now())
 @@index([customerId, assignedAt])
 @@index([toOwnerId, assignedAt])
}
model AccountAudit {
 id String @id @default(cuid())
 subjectId String
 actorId String
 action String @db.VarChar(32)
 createdAt DateTime @default(now())
 @@index([subjectId, createdAt])
}
model SalesTarget {
 id String @id @default(cuid())
 periodKey String @unique
 periodType String
 year Int
 month Int?
 week Int?
 targetRevenue Decimal
 manual Boolean @default(false)
 currency String @default("CNY")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Setting {
 id String @id @default("system")
 companyName String @default("木远家具贸易")
 currency String @default("CNY")
 timezone String @default("Asia/Shanghai")
 firstContactHours Int @default(24)
 // POOL：自动线索进入待分配池；ROUND_ROBIN：按轮流顺序分给启用的销售。
 leadAssignMode String @default("POOL") @db.VarChar(16)
 // 24 小时内的广告留资分配后须在此分钟数内首次联系；其他客户仍按 firstContactHours。
 adLeadFirstContactMinutes Int @default(5)
 // 美元/人民币汇率。默认 6.70 取自 2026 中英文两份报价表之间的隐含汇率（54 组中 44 组精确为 6.70）。
 usdCnyRate Decimal @default(6.70) @db.Decimal(10, 4)
 // 欧元/人民币汇率。为空时欧元报价不自动折算单价与运费，需要手动填写。
 eurCnyRate Decimal? @db.Decimal(10, 4)
 // 手机 / 浏览器系统推送（Web Push）的 VAPID 密钥：未配置环境变量时首次使用自动生成，私钥用 AUTH_SECRET 加密保存。
 pushPublicKey String @default("") @db.VarChar(255)
 pushPrivateKey String @default("") @db.VarChar(255)
}

model LeadSubmission {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 eventKey String @unique
 leadId String @default("")
 ordinal Int
 occurredAt DateTime
 values String @db.LongText
 raw String @db.LongText
 filename String
 fileHash String
 translationPending String @db.Text
 createdAt DateTime @default(now())
 @@unique([customerId, ordinal])
 @@index([customerId, occurredAt])
}

model WhatsAppMessage {
 id String @id @default(cuid())
 providerAccountId String? @db.VarChar(191)
 sourcePhone String? @db.VarChar(16)
 destinationPhone String? @db.VarChar(16)
 providerOccurredAt DateTime?
 deliveredAt DateTime?
 readAt DateTime?
 failedAt DateTime?
 conversationId String?
 conversation WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 waMessageId String? @unique
 source String @default("legacy") @db.VarChar(24)
 sourceMessageId String? @db.Text
 sourceKey String? @unique @db.Char(64)
 attachmentMetadata String? @db.Text
 requestId String? @unique
 providerMessageId String? @unique
 sender String @default("")
 waId String @default("")
 direction String
 messageType String @default("TEXT")
 content String @map("text") @db.Text
 mediaUrl String? @db.Text
 mimeType String?
 fileName String?
 status String @default("")
 sentAt DateTime
 raw String @db.LongText
 aiProcessedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([conversationId, sentAt, id])
 @@index([customerId, sentAt])
 @@index([waId])
}

model WhatsAppSyncToken {
 id String @id @default(cuid())
 userId String
 label String @db.VarChar(80)
 accountPhone String @db.VarChar(16)
 tokenHash String @unique @db.Char(64)
 expiresAt DateTime
 revokedAt DateTime?
 lastUsedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId, createdAt])
}

model WhatsAppSyncRun {
 id String @id @default(cuid())
 userId String
 accountPhone String @db.VarChar(16)
 success Int @default(0)
 skipped Int @default(0)
 failed Int @default(0)
 unmatched Int @default(0)
 errors String @db.Text
 createdAt DateTime @default(now())
 @@index([userId, createdAt])
}

model WhatsAppUnmatchedMessage {
 id String @id @default(cuid())
 provider String @default("whatsapp_web") @db.VarChar(24)
 providerAccountId String? @db.VarChar(191)
 canonicalConversationId String?
 canonicalConversation WhatsAppConversation? @relation(fields: [canonicalConversationId], references: [id], onDelete: Restrict)
 sourceKey String @unique @db.Char(64)
 userId String
 accountPhone String @db.VarChar(16)
 conversationId String @db.VarChar(191)
 sourceMessageId String @db.Text
 peerPhone String? @db.VarChar(16)
 peerName String @default("") @db.VarChar(191)
 direction String @db.VarChar(8)
 sentAt DateTime
 content String @map("text") @db.Text
 attachments String @db.Text
 reason String @db.VarChar(32)
 status String @default("PENDING") @db.VarChar(16)
 customerId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId, status, createdAt])
}

model CustomerIntelligence {
 id String @id @default(cuid())
 customerId String @unique
 customer Customer @relation(fields: [customerId], references: [id])
 score Int @default(0)
 priority String @default("UNRANKED")
 intent String @default("UNKNOWN")
 customerType String @default("UNKNOWN")
 productsJson String @db.Text
 summary String? @db.Text
 aiAnalysis Json?
 humanOverrides Json?
 lastAnalyzedMessageId String?
 lastAnalyzedMessageAt DateTime?
 nextFollowUpAt DateTime?
 analysisPending Boolean @default(false)
 analysisError String? @db.Text
 quantity Int?
 currentNeed String @default("")
 mainObjection String @default("")
 suggestedStage String @default("")
 nextAction String @default("")
 reason String @default("")
 risk String @default("")
 confidence Int @default(0)
 lastMessageAt DateTime?
 analyzedAt DateTime?
 updatedAt DateTime @updatedAt
 @@index([priority])
 @@index([score])
 @@index([intent])
}

model MetaImportRun {
 id String @id
 userId String
 resultPayload Json?
 result String
 createdAt DateTime @default(now())
}

model TranslationSetting {
 id String @id @default("meta")
 endpoint String @default("")
 encryptedKey String @default("")
}

model WhatsAppIntegration {
 id String @id @default("primary")
 status String @default("DISCONNECTED")
 connectionMode String @default("COEXISTENCE")
 businessId String @default("")
 wabaId String @default("")
 phoneNumberId String @default("")
 displayPhoneNumber String @default("")
 verifiedName String @default("")
 encryptedAccessToken String @db.LongText
 tokenExpiresAt DateTime?
 scopes String @db.Text
 subscribedAt DateTime?
 connectedAt DateTime?
 lastVerifiedAt DateTime?
 lastError String @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([wabaId])
 @@index([phoneNumberId])
}

model Task {
 id String @id @default(cuid())
 customerId String?
 customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
 title String
 description String @db.Text
 type String @default("FOLLOW_UP")
 priority String @default("MEDIUM")
 status String @default("TODO")
 dueDate DateTime
 completedAt DateTime?
 createdBy String
 // 不关联客户的任务可指定执行人；关联客户的任务由客户当前负责人执行。
 assigneeId String?
 source String @default("MANUAL")
 automationKey String? @unique
 // 任务必须能追溯到业务对象：客户已有，这里补订单、金额与 AI 生成理由
 orderId String?
 order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
 amount Decimal? @db.Decimal(14, 2)
 aiReason String? @db.Text
 deletedAt DateTime?
 reminderMinutes Int @default(30)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 reminders Reminder[]
 @@index([createdBy, status, dueDate])
 @@index([assigneeId, status, dueDate])
 @@index([customerId, status])
 @@index([status, dueDate])
}
model Reminder {
 id String @id @default(cuid())
 taskId String
 task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
 remindAt DateTime
 status String @default("PENDING")
 kind String @default("EARLY")
 createdAt DateTime @default(now())
 @@unique([taskId, kind])
 @@index([status, remindAt])
}
model WhatsAppReadState {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 userId String
 readAt DateTime
 @@unique([customerId, userId])
}
model Order {
 id String @id @default(cuid())
 orderNo String @unique @db.VarChar(40)
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 // 一笔成交对应一张订单；复购会产生新成交，因而产生新订单。唯一约束用于幂等。
 dealId String? @unique
 deal Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
 // 金额统一以人民币展示；原币种与原币金额保留，便于核对换算来源
 amountRMB Decimal @db.Decimal(14, 2)
 currency String @default("CNY") @db.VarChar(3)
 sourceAmount Decimal? @db.Decimal(14, 2)
 // 流程固定七段：下单 → 付款 → 生产 → 发货 → 运输 → 清关 → 收货
 // status 决定状态页签；进度条由 status 推导，不另存冗余字段以免不一致
 status String @default("PENDING_PAYMENT") @db.VarChar(24)
 paymentStatus String @default("UNPAID") @db.VarChar(24)
 productionStatus String @default("NOT_STARTED") @db.VarChar(24)
 shippingStatus String @default("NOT_SHIPPED") @db.VarChar(24)
 orderDate DateTime @default(now())
 estimatedDelivery DateTime?
 notes String @db.Text
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tasks Task[]
 attribution OrderAttribution?
 feedback AdvertisingFeedback[]
 @@index([customerId, status])
 @@index([status, orderDate])
 @@index([estimatedDelivery])
}

model Quotation {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 quoteNumber String @unique
 product String
 quantity Int
 unitPrice Decimal @db.Decimal(14, 2)
 currency String
 incoterm String
 notes String @db.Text
 status String @default("DRAFT")
 sentAt DateTime?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 // ── 多行报价单（产品库 → 报价单）。旧的单行报价这些列保持为空，金额仍按 unitPrice × quantity。
 // 多行报价：product 为产品摘要，quantity 为总件数，unitPrice 为均价（仅供旧读取方兜底），
 // 报价金额以 totalAmount 为准（含运费与其他费用）。
 language String @default("en") @db.VarChar(4)
 quoteDate DateTime?
 validUntil DateTime?
 subtotalAmount Decimal? @db.Decimal(14, 2)
 freightAmount Decimal? @db.Decimal(14, 2)
 otherAmount Decimal? @db.Decimal(14, 2)
 totalAmount Decimal? @db.Decimal(14, 2)
 totalQuantity Int?
 totalCbm Decimal? @db.Decimal(10, 4)
 totalGrossWeightKg Decimal? @db.Decimal(12, 2)
 destination String @default("") @db.VarChar(120)
 freightRateId String?
 freightRate FreightRate? @relation(fields: [freightRateId], references: [id], onDelete: SetNull)
 // 报价当时的买方、条款、抬头与运费计算快照：之后改模板或运费库，已报出的单据不变。
 documentJson String? @db.Text
 items QuotationItem[]
 @@index([customerId, createdAt])
 @@index([createdAt])
 @@index([freightRateId])
}
// 报价单明细行：规格、包装、价格均为报价当时的快照，便于日后核对「给这个客户报过什么价」。
model QuotationItem {
 id String @id @default(cuid())
 quotationId String
 quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
 sort Int @default(0)
 productId String?
 variantId String?
 model String @db.VarChar(80)
 name String @db.VarChar(200)
 dimensions String @default("") @db.VarChar(200)
 material String @default("") @db.VarChar(400)
 packing String @default("") @db.VarChar(300)
 unit String @default("") @db.VarChar(20)
 imageKey String? @db.VarChar(191)
 note String @default("") @db.VarChar(300)
 quantity Int
 cbm Decimal @default(0) @db.Decimal(8, 4)
 grossWeightKg Decimal @default(0) @db.Decimal(8, 2)
 unitPrice Decimal @db.Decimal(14, 2)
 amount Decimal @db.Decimal(14, 2)
 // 报价当时价格表给出的建议价（内部参考，不出现在单据上）与单价来源：LIST / LAST_QUOTE / MANUAL
 listPrice Decimal? @db.Decimal(14, 2)
 priceSource String @default("MANUAL") @db.VarChar(16)
 createdAt DateTime @default(now())
 @@index([quotationId, sort])
 @@index([variantId])
}
// 运费库：按目的国维护，例如 法国 DDP 22 CNY/kg、印度 550 USD/CBM。
model FreightRate {
 id String @id @default(cuid())
 country String @db.VarChar(80)
 port String @default("") @db.VarChar(120)
 // SEA / AIR / EXPRESS / RAIL / TRUCK
 mode String @default("SEA") @db.VarChar(16)
 incoterm String @default("DDP") @db.VarChar(8)
 // KG / CBM / CONTAINER_20GP / CONTAINER_40HQ / SHIPMENT
 basis String @db.VarChar(16)
 rate Decimal @db.Decimal(14, 2)
 currency String @db.VarChar(3)
 // 计泡系数：每立方米按多少公斤计费（按公斤计费时取 实重 与 体积×系数 的较大值）
 volumetricKgPerCbm Int?
 // 最低计费量，单位与计费方式一致（如 21 kg、1 CBM）
 minChargeQty Decimal? @db.Decimal(10, 2)
 transitDays String @default("") @db.VarChar(40)
 note String @default("") @db.VarChar(500)
 status String @default("ACTIVE") @db.VarChar(16)
 createdBy String
 updatedBy String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 quotations Quotation[]
 @@index([status, country])
}
// 报价单模板：每种语言一行（zh / en / fr）。没有记录时使用代码里的默认文案，保存后以数据库为准。
model QuoteTemplate {
 language String @id @db.VarChar(4)
 title String @db.VarChar(120)
 companyLine String @db.VarChar(300)
 contactLine String @db.VarChar(400)
 paymentTerms String @db.VarChar(400)
 leadTime String @db.VarChar(400)
 moq String @db.VarChar(400)
 packing String @db.VarChar(400)
 warranty String @db.VarChar(400)
 priceBasis String @db.VarChar(400)
 notes String @db.Text
 footer String @db.VarChar(200)
 preparedByRole String @db.VarChar(60)
 unitLabel String @db.VarChar(20)
 validDays Int @default(15)
 updatedBy String
 updatedAt DateTime @updatedAt
}
model WorkflowEvent {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 kind String
 happenedAt DateTime
 expectedAt DateTime?
 description String @db.Text
 requestId String @unique
 createdBy String
 createdAt DateTime @default(now())
 @@index([customerId, happenedAt])
}
model MediaAsset {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 createdBy String
 fileName String
 mimeType String
 storageKey String @unique
 size Int
 createdAt DateTime @default(now())
 @@index([customerId])
}

// BOS growth foundation. No external ad accounts are connected in Core v1.
model LeadSource {
 id String @id @default(cuid())
 name String
 channel String
 externalId String?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 campaigns Campaign[]
 @@index([createdBy, channel])
}
model Campaign {
 id String @id @default(cuid())
 name String
 channel String
 externalId String?
 sourceId String?
 source LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
 currency String @default("USD")
 status String @default("DRAFT")
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 metrics MarketingMetric[]
 @@index([createdBy, channel])
 @@index([sourceId])
}
model MarketingMetric {
 id String @id @default(cuid())
 campaignId String
 campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
 metricDate DateTime @db.Date
 spend Decimal @db.Decimal(14, 2)
 impressions Int @default(0)
 clicks Int @default(0)
 leads Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([campaignId, metricDate])
 @@index([metricDate])
}

// ═══════════════════════════════════════════════════════════
// Product OS — 产品中心（V1）
// 加性变更：仅新增表，不修改任何现有表结构。
// 权威规则（业务确认 2026-09-22）：
//   - 规格 / 包装 / CBM / 毛重 / 价格 一律以报价表为准
//   - 报价为 FOB；MOQ 按渠道分档（线上 10 / 线下 20）
// ═══════════════════════════════════════════════════════════

model ProductCategory {
  id String @id @default(cuid())
  code String @unique @db.VarChar(32)
  nameEn String
  nameCn String @default("")
  level Int @default(1)
  codePrefix String @default("") @db.VarChar(4)
  sort Int @default(0)
  createdAt DateTime @default(now())
  parentId String?
  parent ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  @@index([parentId])
  @@index([level, sort])
}

model ProductSeries {
  id String @id @default(cuid())
  code String @unique @db.VarChar(32)
  nameEn String
  nameCn String @default("")
  descriptionEn String @db.Text
  descriptionCn String @db.Text
  sort Int @default(0)
  createdAt DateTime @default(now())
  products Product[]
}

model Product {
  id String @id @default(cuid())
  model String @unique @db.VarChar(64)
  nameEn String
  nameCn String @default("")
  categoryId String
  category ProductCategory @relation(fields: [categoryId], references: [id])
  seriesId String?
