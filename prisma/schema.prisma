// ═══════════════════════════════════════════════════════════
// 产品成本与毛利
//
// 工厂成本与采购成本是**两种供货方式**，不是相加的分项：
//   - 工厂成本：我们自己工厂做出来的基本成本
//   - 采购成本：从其他工厂采购同款的价格
// 每个尺寸变体通常只会填其中一个（没做的产品就是外购的）。
//
// 成本不含国内运费与报关，因此算出来的是「生产毛利」，界面须如实标注。
// 成本属于敏感数据：所有读写接口仅限管理员，且不得出现在非管理员的产品查询结果中。
// ═══════════════════════════════════════════════════════════
model ProductCost {
  id String @id @default(cuid())
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currency String @default("CNY") @db.VarChar(3)
  factoryCost Decimal? @db.Decimal(14, 2)
  purchaseCost Decimal? @db.Decimal(14, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  status String @default("ACTIVE") @db.VarChar(16)
  note String @db.Text
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([variantId, status])
  @@index([effectiveFrom])
}

// ═══════════════════════════════════════════════════════════
// Meta Facebook Lead Ads 事件
//
// Meta 会重复推送同一个 leadgen_id（重试、订阅重复等）。
// leadgenId 唯一约束是幂等键：同一个线索只会建一次客户。
// 与 LeadSubmission 区分：那张表服务于「Meta CSV 导入」（有 filename/fileHash/行号），
// 这里服务于 webhook 推送，两者的语义与生命周期都不同。
// ═══════════════════════════════════════════════════════════
model MetaLeadEvent {
 id String @id @default(cuid())
 leadgenId String @unique
 pageId String @default("")
 formId String @default("")
 // 广告归因：线索来自哪条广告 / 哪个广告系列（Graph API leadgen 详情返回）
 adId String?
 campaignId String?
 customerId String?
 customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
 // 原始推送内容，便于事后追溯广告来源与表单答案
 rawPayload Json
 // RECEIVED | CREATED | LINKED | SKIPPED | FAILED
 status String @default("RECEIVED") @db.VarChar(16)
 error String @db.Text
 processingStartedAt DateTime?
 // 首次收到的渠道：WEBHOOK 实时推送 | POLL 定时补拉（说明当时 Webhook 没有送达）
 receivedVia String @default("WEBHOOK") @db.VarChar(16)
 // 客户在 Meta 提交表单的时间（Graph created_time），用于计算入库时延
 metaCreatedAt DateTime?
 // 自动重试：失败次数与下次重试时间（指数退避）
 attempts Int @default(0)
 nextAttemptAt DateTime?
 createdAt DateTime @default(now())
 @@index([formId, createdAt])
 @@index([status, nextAttemptAt])
 @@index([receivedVia, createdAt])
 @@index([customerId])
 @@index([status, createdAt])
 @@index([campaignId])
}

// ═══════════════════════════════════════════════════════════
// Meta Ads（Marketing API）与 Lead Ads 表单目录
// 加性变更：仅新增表，不修改任何现有表结构。
//   - MetaAdAccount：广告账户缓存（名称/币种/状态）
//   - MetaLeadForm：leadgen_forms 目录缓存（表单名/问题/线索数）
//   - MetaSyncRun：同步执行记录，cron 与手动触发共用
// ═══════════════════════════════════════════════════════════
model MetaAdAccount {
 id String @id @default(cuid())
 externalId String @unique
 name String
 currency String @default("USD")
 timezone String @default("")
 // Meta account_status 原值（1=ACTIVE 等）
 status Int @default(0)
 disableReason Int @default(0)
 syncedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model MetaLeadForm {
 id String @id @default(cuid())
 formId String @unique
 pageId String @default("")
 name String
 status String @default("")
 // leadgen_forms 的 questions 数组原文（key/label/type/options）
 questions Json?
 // 广告平台统计的线索总数（leads_count）
 leadsCount Int @default(0)
 syncedAt DateTime?
 // 定时补拉：已拉到的最新线索提交时间与最近一次补拉时间
 pollWatermark DateTime?
 polledAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([pageId])
}

model MetaSyncRun {
 id String @id @default(cuid())
 // ADS | FORMS | ALL
 kind String @db.VarChar(16)
 // RUNNING | OK | FAILED
 status String @db.VarChar(16)
 // 成功后的统计（campaigns/metrics/forms 等）
 detail Json?
 error String @db.Text
 startedAt DateTime @default(now())
 finishedAt DateTime?
 @@index([kind, startedAt])
}

