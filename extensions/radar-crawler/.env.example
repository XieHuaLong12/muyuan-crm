# 不要加引号：docker --env-file 会把引号当成值的一部分。
# BOS 的公网地址（不带结尾的 /）
BOS_URL=https://你的域名
# 与 BOS 环境变量 RADAR_INGEST_SECRET 相同；只用于爬虫的三个接口
RADAR_INGEST_SECRET=
# 可选：固定 google-maps-scraper 镜像版本（第一次跑通后建议固定）
SCRAPER_IMAGE=gosom/google-maps-scraper:latest
# 可选：地图结果翻页深度与并发；被限制时先调小
SCRAPER_DEPTH=1
SCRAPER_CONCURRENCY=2
