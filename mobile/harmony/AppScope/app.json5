{
  "app": {
    // HarmonyOS 应用包名，与 AppGallery Connect 中创建的 APP ID 一致；发布后不能修改。
    // AGC 要求 HarmonyOS 包名不能与 Android 包名相同，以后的 Android 版另用包名（见 docs/mobile-app/NATIVE_PLAN.md）。
    "bundleName": "online.avenlee.bos",
    "vendor": "avenlee",
    "versionCode": 1003000,
    "versionName": "1.3.0",
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
