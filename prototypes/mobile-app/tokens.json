{
  "$description": "LVANJU BOS Mobile design tokens. Single source for the prototype (css/tokens.css), Android (Compose theme) and HarmonyOS (resources/base|dark/element/*.json). Units: dp on Android, vp on HarmonyOS; font sizes sp / fp.",
  "$version": "1.0.0",
  "$hexFormat": "8-digit colours are CSS order #RRGGBBAA; Android Color(0xAARRGGBB) and HarmonyOS #AARRGGBB need the alpha moved to the front.",
  "color": {
    "light": {
      "bg": "#F5F6F2",
      "surface": "#FFFFFF",
      "surface2": "#EFF1EC",
      "surface3": "#E5E9E3",
      "line": "#16342819",
      "lineSoft": "#1634280F",
      "ink": "#15211B",
      "ink2": "#56635C",
      "ink3": "#6B766F",
      "inkDisabled": "#A9B2AC",
      "brand": "#164B3A",
      "brandPressed": "#0F3A2D",
      "brandInk": "#164B3A",
      "brandSoft": "#E6F0EA",
      "brandTint": "#F0F6F2",
      "onBrand": "#FFFFFF",
      "focus": "#498B73",
      "logo": "#2E534B",
      "success": "#1F7A4D", "successBg": "#E5F3EA",
      "warning": "#8A5414", "warningBg": "#FBF0E1",
      "danger": "#A8432F", "dangerBg": "#FBEBE6",
      "info": "#2B5D8C", "infoBg": "#E8F0F8",
      "chart1": "#1F6B52", "chartPrev": "#B4BDB7",
      "seq1": "#164B3A", "seq2": "#5F9B82", "seq3": "#CFE0D6"
    },
    "dark": {
      "bg": "#0D1310",
      "surface": "#151C18",
      "surface2": "#1C2520",
      "surface3": "#25302A",
      "line": "#DCF0E41A",
      "lineSoft": "#DCF0E40F",
      "ink": "#E7EDE9",
      "ink2": "#A9B5AE",
      "ink3": "#8E9A93",
      "inkDisabled": "#56615A",
      "brand": "#2F7A5F",
      "brandPressed": "#276A52",
      "brandInk": "#86CFAE",
      "brandSoft": "#1B3329",
      "brandTint": "#17241E",
      "onBrand": "#FFFFFF",
      "focus": "#6FB898",
      "logo": "#2E534B",
      "success": "#74C99A", "successBg": "#173225",
      "warning": "#E3B06A", "warningBg": "#3A2A14",
      "danger": "#F0907A", "dangerBg": "#3B1D17",
      "info": "#8DB8E8", "infoBg": "#172A3D",
      "chart1": "#5FBF96", "chartPrev": "#4A564F",
      "seq1": "#86CFAE", "seq2": "#3F8A6C", "seq3": "#25433A"
    },
    "$contrast": "light ink 16.6:1, ink2 6.3:1, ink3 4.7:1 on surface; white on brand 10:1; dark ink 14.6:1, ink2 8.2:1, ink3 5.3:1; white on dark brand 5.2:1",
    "$fromBOS": "brand = app/bos.css --bos-green (#164b3a); focus = .bos :focus-visible (#498b73); warning/danger tones from .bos-badge-warning and .bos-sales-error; tag colours from lib/customer-tags.ts"
  },
  "type": {
    "fontFamily": { "android": "Roboto + Noto Sans CJK SC (system)", "harmony": "HarmonyOS Sans SC (system)", "numerals": "tabular figures for columns; proportional for hero figures" },
    "display": { "size": 32, "line": 40, "weight": 650, "use": "one hero figure per view" },
    "titleL": { "size": 24, "line": 30, "weight": 650, "use": "large page title" },
    "titleM": { "size": 18, "line": 26, "weight": 600, "use": "app bar, sheet title" },
    "titleS": { "size": 16, "line": 24, "weight": 600, "use": "card title, list primary" },
    "body": { "size": 15, "line": 22, "weight": 400 },
    "bodyS": { "size": 14, "line": 20, "weight": 400 },
    "caption": { "size": 13, "line": 18, "weight": 400, "use": "metadata" },
    "micro": { "size": 12, "line": 16, "weight": 500, "use": "badges, nav labels — minimum for Chinese" },
    "scaling": "all text in sp/fp; layouts tested at 100% / 112% / 125% and follow the system font size"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "gutter": 16 },
  "radius": { "xs": 6, "sm": 10, "md": 12, "lg": 16, "xl": 20, "sheet": 24, "pill": 999 },
  "size": { "touchTarget": 48, "control": 44, "appBar": 56, "bottomNav": 64, "fab": 56, "avatar": 44, "avatarLg": 56, "icon": 22, "iconSm": 18 },
  "icon": { "set": "Lucide 0.468.0 (same as PC lucide-react)", "stroke": 1.75, "grid": 24, "android": "export to VectorDrawable", "harmony": "export to SVG resources (media/*.svg)" },
  "motion": { "fast": 140, "base": 220, "slow": 320, "easing": "cubic-bezier(.2,.8,.2,1)", "reduceMotion": "respect system setting" },
  "elevation": { "light": { "1": "0 1 2 #10241C0A", "2": "0 6 24 #10241C14", "3": "0 -10 40 #10241C29" }, "dark": "use borders and surface steps instead of shadows" }
}
